on: [pull_request]

jobs:
  oidc_debug_test:
    permissions:
      contents: read
      id-token: write
    runs-on: ubuntu-latest
    name: A test of the oidc debugger
    steps:
      - name: Checkout actions-oidc-debugger
        uses: actions/checkout@v3
        with:
          repository: github/actions-oidc-debugger
          ref: main
          token: ${{ secrets.your-checkout-token }}
          path: ./.github/actions/actions-oidc-debugger
      - name: Debug OIDC Claims
        uses: ./.github/actions/actions-oidc-debugger
        with:
          audience: '${{ github.server_url }}/${{ github.repository_owner }}'
คุกกี้เหล่านี้จำเป็นต่อการทำงานของเว็บไซต์และไม่สามารถปิดการใช้งานได้ในระบบของเรา โดยปกติแล้วคุกกี้จะถูกตั้งค่าเพื่อตอบสนองต่อการกระทำของคุณที่ถือเป็นคำขอรับบริการ เช่น การตั้งค่าความเป็นส่วนตัว การเข้าสู่ระบบ หรือการกรอกแบบฟอร์ม คุณสามารถตั้งค่าเบราว์เซอร์ให้บล็อกหรือแจ้งเตือนคุณเกี่ยวกับคุกกี้เหล่านี้ได้ แต่บางส่วนของเว็บไซต์จะไม่ทำงาน คุกกี้เหล่านี้จะไม่จัดเก็บข้อมูลส่วนตัวที่สามารถระบุตัวตนได้
หมายเหตุ: เบราว์เซอร์รุ่นเก่าอาจขาดฟังก์ชันการทำงานพร้อมฟีเจอร์ที่ใหม่ ขึ้นและการแชทด้วยเสียงสำหรับ Firefox รองรับเฉพาะเวอร์ชัน 80 ขึ้นไปเท่านั้น!
